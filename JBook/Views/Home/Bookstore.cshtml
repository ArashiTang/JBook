@{
    ViewData["Title"] = "Bookstore";
}

<div class="container-fluid mt-4">
    <div class="row">
        <!-- 左侧导航栏 -->
<div class="col-md-3 col-lg-2 border-end pe-0">
    <h5 class="px-3 mb-3">Categories</h5>
    <div class="d-flex flex-column gap-2 px-3">
        @{
            var categories = new[]
            {
                "Fantasy", "Wuxia", "Xianxia", "City", "Realistic", "Military", "History", 
                "Game", "Sports", "Sci-Fi", "Infinite", "Mystery", "Light Novel"
            };
        }
        @foreach (var cat in categories)
        {
            <div class="bg-light d-flex align-items-center gap-2 p-2 rounded shadow-sm">
                <div style="width: 28px; height: 28px; background-color: #ddd; border-radius: 6px;"></div>
                <span>@cat</span>
            </div>
        }
    </div>
</div>


        <!-- 右侧内容区 -->
        <div class="col-md-9 col-lg-10">
           
            
            @for (int i = 0; i < 10; i++)
            {
                <div class="d-flex border rounded p-3 mb-3 bg-white shadow-sm align-items-center">
                    <!-- 封面 -->
                    <img src="https://via.placeholder.com/100x130?text=Book" class="me-4" style="width:100px; height:130px; object-fit:cover;" alt="Cover" />

                    <!-- 内容 -->
                    <div class="flex-grow-1">
                        <h5 class="mb-1">Book Title @i</h5>
                        <p class="mb-1 text-muted">
                            <small>Author Name | Genre | Tag | Status</small>
                        </p>
                        <p class="text-secondary" style="font-size: 14px;">
                            This is a short description of the book @i. It tells a mysterious or thrilling story...
                        </p>
                        <p class="mb-1 text-muted"><small>Updated: 2025-06-12 00:30</small></p>
                    </div>

                    <!-- 操作 -->
                    <div class="text-end" style="min-width: 150px;">
                        <a href="#" class="btn btn-danger btn-sm me-2">Details</a>
                        <a href="/Home/CheckLogin?redirect=Bookshelf" class="btn btn-outline-secondary btn-sm">Add to Shelf</a>

                    </div>
                </div>
            }
        </div>
    </div>
</div>
