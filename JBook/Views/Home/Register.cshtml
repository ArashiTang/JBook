@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5 d-flex justify-content-center">
    <div class="bg-white shadow rounded-3 px-5 py-4" style="width: 600px; max-width: 100%;">
        <h2 class="text-center mb-4">User Registration</h2>

        <form method="post" asp-action="Register" asp-controller="Home">
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info">@ViewBag.Message</div>
            }

            <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control" name="username" id="username" placeholder="Enter username" required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control" name="password" id="password" placeholder="8-16 characters" required />
            </div>

            <div class="mb-3">
                <label for="confirm" class="form-label">Confirm</label>
                <input type="password" class="form-control" name="confirm" id="confirm" placeholder="Re-enter password" required />
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="agree" required>
                <label class="form-check-label" for="agree">
                    I have read and agree to the <a href="/Home/Privacy" target="_blank">Terms of Service</a> and <a href="/Home/Privacy" target="_blank">Privacy Policy</a>.
                </label>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-dark">Register Now</button>
            </div>
        </form>
    </div>
</div>
