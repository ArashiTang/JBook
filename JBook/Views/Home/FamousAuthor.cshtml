@{
    ViewData["Title"] = "Famous Authors";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Hero Section -->
<div class="hero-banner text-white d-flex flex-column justify-content-center align-items-center text-center mb-5">
    <h1 class="display-4 fw-bold">Famous Authors</h1>
<p class="lead">Renowned Authors with Global Influence and Literary Legacy</p>

</div>

<div class="container my-5">


    <div class="row row-cols-1 row-cols-md-2 g-4">
        @for (int i = 0; i < 20; i++)
        {
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card shadow-lg h-100 p-3" style="min-height: 180px;">
                        <div class="d-flex">
                            <img src="https://via.placeholder.com/100" class="rounded-circle me-4" alt="Author"
                                style="width:100px; height:100px; object-fit:cover;" />
                            <div>
                                <h4 class="card-title">Author Name @i</h4>
                                <p class="card-text text-muted">
                                    This is a brief introduction of author @i. Lorem ipsum dolor sit amet, consectetur
                                    adipiscing elit.
                                </p>
                                <p class="mb-0"><strong>Books:</strong> <a href="#">Book A</a>, <a href="#">Book B</a>, <a
                                        href="#">Book C</a></p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>
