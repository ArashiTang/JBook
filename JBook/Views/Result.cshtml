@model JBook.Shared.Models.CombinedSearchResult

@{
    ViewData["Title"] = "Search Results";
}

<h2>Search Results</h2>

<hr />
<h3>📥 User uploaded books</h3>
@if (Model.UserBooks.Any())
{
    foreach (var book in Model.UserBooks)
    {
        <div>
            <a href="@book.Url" target="_blank">@book.Title - @book.Author - @book.Description</a>
        </div>
    }
}
else
{
    <p>There are currently no results uploaded by users.</p>
}

<hr />
<h3>🔍 ZLibrary:</h3>
@if (Model.ZLibraryBooks.Any())
{
    foreach (var book in Model.ZLibraryBooks)
    {
        <div>
            <a href="@book.Url" target="_blank">@book.Title - @book.Author - @book.Description</a>
        </div>
    }
}
else
{
    <p>ZLibrary No results found.</p>
}

<hr />
<h3>🔍 OpenLibrary:</h3>
@if (Model.OpenLibraryBooks.Any())
{
    foreach (var book in Model.OpenLibraryBooks)
    {
        <div>
            <a href="@book.Url" target="_blank">@book.Title - @book.Author - @book.Description</a>
        </div>
    }
}
else
{
    <p>OpenLibrary No results found.</p>
}
