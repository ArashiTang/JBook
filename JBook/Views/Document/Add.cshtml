@model JBook.Models.Document

@{
    ViewData["Title"] = "Add Book";
}

<!-- Frosted outer centered container -->
<div class="add-content-blur">
    <h2 class="add-title">Add Book</h2>
    <form asp-action="Add" method="post" enctype="multipart/form-data" style="width:100%;">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="form-group-custom">
            <label for="Title" class="form-label-custom">Book Title <span class="star">*</span></label>
            <input id="Title" name="Title" class="form-control-custom" />
        </div>

        <div class="form-group-custom">
            <label for="Author" class="form-label-custom">Author Name <span class="star">*</span></label>
            <input id="Author" name="Author" class="form-control-custom" />
        </div>

        <div class="form-group-custom">
            <label for="File" class="form-label-custom">Upload File <span class="star">*</span></label>
            <input id="File"
                   name="File"
                   type="file"
                   class="form-control-custom"
                   accept=".txt,.pdf,.epub"
                   required />
            <div class="form-desc-tip">
                Only <code>.txt</code>, <code>.pdf</code> or <code>.epub</code> files are allowed.
            </div>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn-addbook">Add</button>
            <a asp-action="Bookshelf" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Styles {
    <style>
        </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('File').addEventListener('change', function () {
          const allowed = ['txt','pdf','epub'];
          const file = this.files[0];
          if (file) {
            const ext = file.name.split('.').pop().toLowerCase();
            if (!allowed.includes(ext)) {
              alert('Only .txt, .pdf or .epub files are allowed.');
              this.value = '';
            }
          }
        });


    </script>
}
