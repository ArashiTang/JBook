@model IEnumerable<Report>

@{
    ViewData["Title"] = "Manager Dashboard";
}

@section Styles {
    <style>
        /* Fixed layout table for manager dashboard */
        .table-fixed {
            table-layout: fixed;
            width: 100%;
        }
            /* First column (report message) width */
            .table-fixed th:nth-child(1),
            .table-fixed td:nth-child(1) {
                width: 70%;
            }
            /* Second column (action buttons) width, no wrapping */
            .table-fixed th:nth-child(2),
            .table-fixed td:nth-child(2) {
                width: 30%;
                white-space: nowrap;
            }
    </style>
}

<!-- Manager dashboard header image -->
<div style="width: 100%; display: flex; justify-content: center; align-items: center; margin-top: 40px; margin-bottom: 40px;">
    <img src="~/img/ManagerDashboard.png" alt="Manager Dashboard" style="max-width: 320px; width: 100%; height: auto; filter: drop-shadow(0 2px 14px #00000044);" />
</div>

<!-- Main dashboard frosted content card -->
<div class="manager-content-blur" style="margin-top: 40px; margin-bottom: 50px; display: flex; justify-content: center; align-items: flex-start;">
    <div style="width: 96%; max-width: 1600px;">
        <!-- Report management table -->
        <table class="table table-bordered table-fixed">
            <thead>
                <tr>
                    <th>Report Message</th>
                    <th>Delete BookLink</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rpt in Model)
                {
                    <tr>
                        <!-- Report message content -->
                        <td>@rpt.Message</td>
                        <!-- Action buttons: Execute/Delete and Ignore -->
                        <td>
                            <div class="d-flex">
                                <!-- Execute (delete link) action -->
                                <form asp-action="Execute" method="post" class="me-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reportId" value="@rpt.Id" />
                                    <button type="submit" class="btn btn-danger flex-fill">
                                        Execute
                                    </button>
                                </form>
                                <!-- Ignore report action -->
                                <form asp-action="Ignore" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reportId" value="@rpt.Id" />
                                    <button type="submit" class="btn btn-secondary flex-fill">
                                        Ignore
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
