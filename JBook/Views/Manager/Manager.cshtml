@model IEnumerable<JBook.Models.Report>

@{
    ViewData["Title"] = "Manager Dashboard";
}

<h2>Manager Dashboard</h2>

<h4>Report Records</h4>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Message</th>
            <th>Timestamp</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rpt in Model)
        {
            <tr>
                <td>@rpt.Id</td>
                <td>@rpt.Message</td>
                <td>@rpt.ReportedAt.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
        }
    </tbody>
</table>

<h4>Delete a BookLink</h4>
<form asp-action="DeleteBookLink" method="post" class="form-inline">
    <div class="mb-3">
        <label for="linkId" class="form-label">BookLink Id:</label>
        <input type="number" name="linkId" id="linkId" class="form-control mx-2" required />
        <button type="submit" class="btn btn-danger">Delete</button>
    </div>
</form>