@model JBook.Shared.Models.CombinedSearchResult

@{
    ViewData["Title"] = "Search Results";
    // Take out keyword, formatCounts, selectedFormat from ViewBag
    var keyword = ViewBag.Keyword as string ?? "";
    var counts = ViewBag.FormatCounts as IDictionary<string, int>
                 ?? new Dictionary<string, int>();
    var selFormat = ViewBag.SelectedFormat as string;
    var formats = new[] { "TXT", "EPUB", "MOBI", "PDF", "Other" };
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

@if (TempData["ReportSuccess"] != null)
{
    <div class="alert alert-info">
        @TempData["ReportSuccess"]
    </div>
}

<div class="search-results-page">
    <!-- Top search bar -->
    <div class="top-search-container">
        <form method="get" asp-controller="Search" asp-action="Result" class="d-flex">
            <input type="text"
                   name="keyword"
                   placeholder="Book Title or Author Name"
                   class="form-control me-2"
                   style="width: 550px; padding: 10px; font-size: 16px;"
                   value="@keyword" />
            @* If you have selected a format, you want to include it as a hidden field *@
            @if (!string.IsNullOrEmpty(selFormat))
            {
                <input type="hidden" name="format" value="@selFormat" />
            }
            <button type="submit" class="btn btn-warning">Search</button>
        </form>
    </div>

    <!-- Format filtering bar -->
    <div class="format-filters mb-3 text-center">
        @foreach (var fmt in formats)
        {
            var cnt = counts.ContainsKey(fmt) ? counts[fmt] : 0;
            var isSelected = fmt == selFormat;
            var style = isSelected ? "font-weight:bold; text-decoration:underline;" : "";

            <a asp-action="Result"
               asp-route-keyword="@keyword"
               asp-route-format="@fmt"
               style="@style"
               class="mx-1 fmt-link"
               data-count="@cnt"
               data-format="@fmt">
                @($"{fmt}({cnt})")
            </a>


            @if (fmt != formats.Last())
            {
                <text> |</text>
            }
        }

        @* Clear Filters link *@
        @if (!string.IsNullOrEmpty(selFormat))
        {
            <text>&nbsp;&nbsp;</text>
            <a asp-action="Result"
               asp-route-keyword="@keyword"
               class="text-secondary">
                Clear filter
            </a>
        }
    </div>

    <!-- Added faded blur shell -->
    <div class="search-results-frosted">
        <!-- Main two-column layout -->
        <div class="results-container d-flex" style="gap:30px;">
            <!-- Left side: User shared links -->
            <div class="col-left flex-grow-2">
                @if (Model.UserBooks.Any())
                {
                    <div class="section user-links">
                        @foreach (var b in Model.UserBooks)
                        {
                            <div class="book-item mb-3">
                                <div class="book-header mb-1" style="font-size:16px;">
                                    <span class="book-title text-dark">@b.Title</span>
                                    <span class="book-author text-dark">— @b.Author</span>
                                    <span class="book-format text-dark">(@b.Format)</span>
                                </div>
                                <div class="book-description mb-1 text-muted">@b.Description</div>
                                <div class="book-actions">
                                    <a href="@b.Url" target="_blank" class="me-2">Link</a>
                                    <a asp-controller="Report"
                                       asp-action="Create"
                                       asp-route-linkId="@b.Id"
                                       asp-route-returnUrl="@returnUrl"
                                       class="report">
                                        Report
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Right side: crawler results -->
            <div class="col-right flex-grow-1 border-start ps-3">
                <div class="section zlib-results mb-4">
                    <h4>Z-Library Results</h4>
                    @if (Model.ZLibraryBooks.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var b in Model.ZLibraryBooks)
                            {
                                <li class="mb-2">
                                    <a href="@b.Url" target="_blank">@b.Title — @b.Author</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No Z-Library results.</p>
                    }
                </div>

                <div class="section openlib-results">
                    <h4>OpenLibrary Results</h4>
                    @if (Model.OpenLibraryBooks.Any())
                    {
                        <ul class="list-unstyled">
                            @foreach (var b in Model.OpenLibraryBooks)
                            {
                                <li class="mb-2">
                                    <a href="@b.Url" target="_blank">@b.Title — @b.Author</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>No OpenLibrary results.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .search-results-page {
            padding: 20px;
            font-family: Arial, sans-serif;
        }

        .top-search-container {
            margin-bottom: 20px;
        }

        .format-filters {
            color: #fff;
        }

            .format-filters a {
                color: #fff !important;
                font-size: 14px;
            }

        /* Added blurred frosted shell */
        .search-results-frosted {
            background: rgba(255,255,255,0.72);
            border-radius: 28px;
            box-shadow: 0 6px 32px 0 rgba(60,60,60,0.09), 0 1.5px 6px 0 rgba(60,60,60,0.06);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            padding: 32px 36px 36px 36px;
            margin: 0 auto 40px auto;
            max-width: 1240px;
            min-height: 540px;
            transition: box-shadow .3s;
            border: none;
        }

        .results-container {
            margin-top: 20px;
        }

        .book-item .book-header span {
            margin-right: 8px;
        }

        .format-filters {
            color: #FFD600 !important; /* Bright yellow */
        }

            .format-filters a {
                color: #FFD600 !important; /* All format links are always bright yellow */
                font-size: 14px;
                font-weight: normal;
                text-decoration: none;
                transition: color .2s;
            }

                .format-filters a[style*="font-weight:bold"] {
                    font-weight: bold;
                    text-decoration: underline;
                    color: #FFD600 !important;
                }

        .col-right {
            flex-grow: 0 !important; /* Non-adaptive width */
            width: 340px !important; /* Fixed width, adjust width by yourself */
            min-width: 300px;
            max-width: 420px;
            border-left: 1px solid #ddd;
            padding-left: 32px;
            font-size: 14px;
            position: absolute; /* Absolute positioning to the right */
            top: 90px; /* Leave blank space at the top of the page, the specific value is adjustable */
            right: 80px; /* The distance from the right side can be adjusted according to the actual page */
            background: transparent; /* Keep the original transparency */
            z-index: 2;
        }




            .col-right h4 {
                font-size: 16px;
                margin-bottom: 12px;
            }

            .col-right ul, .col-right li, .col-right p {
                font-size: 13px;
            }

        .col-left {
            margin-left: 110px; 
        }

        .book-header {
            font-size: 28px !important; 
            line-height: 1.2;
            font-family: "Libertinus Serif", serif;
            font-weight: 400;
            font-style: normal;
        }

        .book-title {

        }

        .book-author{
            font-size: 18px

        }

        .book-header .book-format {
            font-size: 16px !important; /* For example, 18px, adjust according to the actual page size */

        }

        .book-description {
            font-size: 16px !important;
            color: #888;
            margin-bottom: 4px;
            font-family: "Libertinus Serif", serif;
            font-weight: 400;
            font-style: normal;
        }

        .book-actions a {
            font-size: 16px !important;
            /* You can add some extra line spacing to make it more beautiful */
            margin-right: 8px;
        }

        .book-item {
            margin-bottom: 56px !important;
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          // Front-end interception: format with quantity 0 does not jump, prompts directly
          document.querySelectorAll('.fmt-link').forEach(function (a) {
            a.addEventListener('click', function (e) {
              var cnt = parseInt(a.dataset.count || '0', 10);
              if (cnt <= 0) {
                e.preventDefault();
                var fmt = a.dataset.format || '';
                alert('Cannot see the source of the book without that format???（' + fmt + '）');
              }
            });
          });
        });
    </script>
}